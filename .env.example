# ============================================================
# Job Agent – Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control – it's already in .gitignore

# ------------------------------------------------------------
# OpenAI (required for AI features)
# ------------------------------------------------------------
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# GPT model to use (gpt-4 recommended, gpt-3.5-turbo for cost savings)
OPENAI_MODEL=gpt-4

# Creativity level: 0.0 = deterministic, 1.0 = very creative
OPENAI_TEMPERATURE=0.7

# ------------------------------------------------------------
# Database (optional – defaults to SQLite in ./data/jobs.db)
# ------------------------------------------------------------
# DATABASE_URL=sqlite:///./data/jobs.db
# DATABASE_URL=postgresql://user:password@localhost:5432/jobagent

# ------------------------------------------------------------
# Scraper settings
# ------------------------------------------------------------
# Seconds to wait between requests (be respectful to job boards!)
SCRAPER_DELAY=2.0
SCRAPER_MAX_RETRIES=3
SCRAPER_TIMEOUT=15

# ------------------------------------------------------------
# Email notifications (optional)
# ------------------------------------------------------------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your.email@gmail.com
# EMAIL_PASSWORD=your-gmail-app-password  # NOT your main password!
# EMAIL_FROM=your.email@gmail.com
# NOTIFICATION_EMAIL=your.email@gmail.com

# ------------------------------------------------------------
# Resume
# ------------------------------------------------------------
# BASE_RESUME_PATH=data/base_resume.json

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
